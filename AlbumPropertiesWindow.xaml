<Window x:Class="ZipMp3Player.AlbumPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アルバムのプロパティ" Icon="Assets/AppIcon.ico" Width="700" Height="650" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#15171B" Foreground="#F2F3F5"
        Loaded="Window_Loaded" Closed="Window_Closed">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="Background" Value="#20252C"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,5"/>
      <Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#303744"/>
      <Setter Property="BorderBrush" Value="#566171"/><Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock x:Name="HeadingText" Text="アルバムのプロパティ" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="StatusText" Text="情報を読み込んでいます…" Foreground="#A9B3C0" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="PropertyRows">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,7">
              <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Label}" Foreground="#B9C9DA" Margin="0,5,12,0" TextWrapping="Wrap"/>
              <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" AutomationProperties.Name="{Binding Label}"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OpenLocationButton" Content="場所を開く" Click="OpenLocation_Click" IsEnabled="False"/>
      <Button x:Name="CopyPathButton" Content="パスをコピー" Click="CopyPath_Click"/>
      <Button Content="閉じる" IsCancel="True" IsDefault="True" Click="Close_Click" MinWidth="80"/>
    </WrapPanel>
  </Grid>
</Window>
