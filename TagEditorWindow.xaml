<Window x:Class="ZipMp3Player.TagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アルバムのタグを編集" Width="1220" Height="660" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#15171B" Foreground="#F2F3F5">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="Background" Value="#2C313A"/><Setter Property="BorderBrush" Value="#4A5260"/></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#18202A"/><Setter Property="Background" Value="#F3F4F6"/><Setter Property="CaretBrush" Value="#18202A"/></Style>
    <Style x:Key="SelectableInfoText" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Cursor" Value="IBeam"/>
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel>
      <TextBlock Text="アルバムのタグを一括編集" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock x:Name="TrackCountText" DockPanel.Dock="Right" Foreground="#AEB8C4" VerticalAlignment="Center"/>
    </DockPanel>
    <Border Grid.Row="1" Margin="0,12,0,12" Padding="10" Background="#1D2B36" BorderBrush="#36536A" BorderThickness="1" CornerRadius="4">
      <StackPanel>
        <TextBox x:Name="SourceTypeText" Style="{StaticResource SelectableInfoText}"
                 FontWeight="SemiBold" Foreground="#8FD2FF"/>
        <TextBox x:Name="SourcePathText" Style="{StaticResource SelectableInfoText}"
                 Margin="0,3,0,0" Foreground="#BBC4CF"/>
        <TextBox x:Name="TagEditNoticeText" Style="{StaticResource SelectableInfoText}"
                 Margin="0,5,0,0" Foreground="#A9D8B5"/>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="2" Margin="0,0,0,8">
      <WrapPanel>
        <Button Content="選択セルの値を全曲へ適用" Padding="11,5" Click="ApplySelectedCellToAll_Click"
              ToolTip="アーティストやアルバムなど、現在のセルと同じ列へ一括適用"/>
        <Button x:Name="NormalizeAlphaNumericButton" Content="全曲の英数字・記号・空白を半角に" Padding="11,5" Margin="8,0,0,0"
                Click="NormalizeAlphaNumeric_Click" ToolTip="このアルバム全曲のファイル名と編集欄にある全角英数字・記号・全角スペースを半角へ変換します。日本語・半角カナ・囲み文字・ローマ数字・スペースの数は変更しません。ファイル名で使用できない半角記号は安全のため全角のまま保持します。保存するまで元ファイルは変わりません。"/>
        <Button x:Name="NormalizeTitleCaseButton" Content="選択範囲の全大文字を先頭大文字に" Padding="11,5" Margin="8,0,0,0"
                Click="NormalizeTitleCase_Click" ToolTip="選択したタイトル・アーティスト・アルバム・ジャンルのうち、すべて大文字の値を Soul Doctor のような表記へ変換します。ファイル名と数値は変更しません。"/>
        <Button x:Name="CheckTagAnomaliesButton" Content="タグ異常をチェック" Padding="11,5" Margin="8,0,0,0"
                Click="CheckTagAnomalies_Click" ToolTip="曲番号の未設定・重複・欠番・突出値・ファイル名との不一致や、主要タグの欠落を確認します。ファイルは変更しません。"/>
        <TextBlock Text="複数セルのコピー・貼り付け: Ctrl+C / Ctrl+V" Margin="12,5,0,5" VerticalAlignment="Center" Foreground="#AEB8C4"/>
      </WrapPanel>
      <TextBlock x:Name="BatchStatusText" Margin="0,5,0,0" Foreground="#8FD2FF" TextWrapping="Wrap"/>
    </StackPanel>
    <DataGrid x:Name="TagsGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              SelectionMode="Extended" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="ExcludeHeader"
              PreviewKeyDown="TagsGrid_PreviewKeyDown" Background="#1E2127" Foreground="#F2F3F5"
              RowBackground="#1E2127" AlternatingRowBackground="#23272E" BorderBrush="#414957"
              GridLinesVisibility="All" HorizontalGridLinesBrush="#353B45" VerticalGridLinesBrush="#353B45">
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Background" Value="#2B313A"/><Setter Property="Foreground" Value="#F2F3F5"/>
          <Setter Property="BorderBrush" Value="#4A5260"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
          <Setter Property="Padding" Value="7,5"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
      </DataGrid.ColumnHeaderStyle>
      <DataGrid.RowHeaderStyle>
        <Style TargetType="DataGridRowHeader">
          <Setter Property="Background" Value="#2B313A"/><Setter Property="Foreground" Value="#F2F3F5"/>
          <Setter Property="BorderBrush" Value="#4A5260"/>
        </Style>
      </DataGrid.RowHeaderStyle>
      <DataGrid.CellStyle>
        <Style TargetType="DataGridCell">
          <Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="BorderBrush" Value="#353B45"/>
          <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="#236FA1"/><Setter Property="Foreground" Value="White"/>
            </Trigger>
          </Style.Triggers>
        </Style>
      </DataGrid.CellStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="ファイル名" Binding="{Binding DisplayFileName, UpdateSourceTrigger=PropertyChanged}" Width="190" MinWidth="130"/>
        <DataGridTextColumn Header="#" Binding="{Binding TrackNumber, UpdateSourceTrigger=PropertyChanged}"
                            SortMemberPath="TrackNumberSort" Width="48"/>
        <DataGridTextColumn Header="タイトル" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="2*" MinWidth="150"/>
        <DataGridTextColumn Header="アーティスト" Binding="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" Width="1.5*" MinWidth="130"/>
        <DataGridTextColumn Header="アルバム" Binding="{Binding Album, UpdateSourceTrigger=PropertyChanged}" Width="1.5*" MinWidth="130"/>
        <DataGridTextColumn Header="年" Binding="{Binding Year, UpdateSourceTrigger=PropertyChanged}"
                            SortMemberPath="YearSort" Width="65"/>
        <DataGridTextColumn Header="ジャンル" Binding="{Binding Genre, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
        <DataGridTextColumn Header="Disc" Binding="{Binding DiscNumber, UpdateSourceTrigger=PropertyChanged}"
                            SortMemberPath="DiscNumberSort" Width="55"/>
        <DataGridTextColumn Header="Disc総数" Binding="{Binding DiscCount, UpdateSourceTrigger=PropertyChanged}"
                            SortMemberPath="DiscCountSort" Width="72"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
      <TextBlock x:Name="ValidationText" DockPanel.Dock="Left" Foreground="#FFB46B" VerticalAlignment="Center" TextWrapping="Wrap" Width="700"/>
      <Button Content="キャンセル" DockPanel.Dock="Right" Width="98" Padding="9,7" Margin="8,0,0,0" IsCancel="True"/>
      <Button Content="まとめて保存" DockPanel.Dock="Right" Width="126" Padding="9,7" Click="Save_Click" IsDefault="True"/>
    </DockPanel>
  </Grid>
</Window>
