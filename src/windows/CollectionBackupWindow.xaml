<Window x:Class="ZipMp3Player.CollectionBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="完全バックアップ" Icon="Assets/AppIcon.ico" Width="880" Height="730"
        MinWidth="650" MinHeight="580" WindowStartupLocation="CenterOwner"
        Background="#15171B" Foreground="#F2F3F5">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#303744"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#566171"/><Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="3"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#F3F4F6"/><Setter Property="Foreground" Value="#18202A"/>
      <Setter Property="Padding" Value="6,5"/><Setter Property="Margin" Value="3"/>
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="コレクションの完全バックアップ" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="管理データ・アプリ本体・登録した音楽フォルダーを個別に選択できます。音楽全体は大容量になります。バックアップは暗号化されません。"
                 Foreground="#B8C5D3" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>
    <TabControl x:Name="ModeTabs" Grid.Row="1" Background="#1E2127" Foreground="White">
      <TabItem Header="作成">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <TextBlock Text="対象を選択" FontWeight="SemiBold" FontSize="15"/>
            <CheckBox x:Name="DataCheck" Content="設定・ライブラリー情報・履歴・お気に入り・取得画像・保存歌詞などの管理データ" IsChecked="True" Margin="0,8,0,3"/>
            <CheckBox x:Name="ApplicationCheck" Content="アプリ本体・ScannerTools・説明資料・ライセンス（実行中の版）" Margin="0,3"/>
            <TextBlock Text="登録した音楽フォルダー（チェックを外して非表示にしたものも選択できます）"
                       Margin="0,12,0,5" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,0,0,4">
              <Button Content="設定・アプリ・音楽をすべて選択" Click="SelectEverything_Click"/>
              <Button Content="音楽フォルダーをすべて選択" Click="SelectAll_Click"/>
              <Button Content="すべて解除" Click="ClearAll_Click"/>
            </WrapPanel>
            <Border Background="#15171B" BorderBrush="#566171" BorderThickness="1" MaxHeight="190" Padding="6">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="FolderChoices">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><CheckBox Content="{Binding Path}" IsChecked="{Binding Include, Mode=TwoWay}" ToolTip="{Binding Path}" Margin="3,5"/></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Text="圧縮方式" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ComboBox x:Name="CompressionChoice" Width="185" SelectedIndex="0">
                <ComboBoxItem Content="高速（推奨）"/>
                <ComboBoxItem Content="圧縮しない"/>
                <ComboBoxItem Content="最大圧縮"/>
              </ComboBox>
              <Button Content="対象のファイル数・容量を計算" Click="Estimate_Click" Margin="13,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="EstimateText" Foreground="#B8C5D3" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="保存前に容量を確認できます。元ファイルは変更しません。"/>
            <TextBlock Text="バックアップの保存先（対象フォルダーの外を指定）" Margin="0,15,0,4" FontWeight="SemiBold"/>
            <DockPanel>
              <Button Content="参照…" DockPanel.Dock="Right" Click="ChooseBackup_Click"/>
              <TextBox x:Name="BackupPathText"/>
            </DockPanel>
            <TextBlock Text="作成後に全ファイルのSHA-256を検証し、成功したバックアップだけを確定します。既存ファイルは上書きしません。サムネイルキャッシュ・一時ファイル・過去の復元安全コピーは含めません。"
                       Foreground="#B8C5D3" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <Button x:Name="CreateButton" Content="選択した内容でバックアップ作成" Click="Create_Click"
                    HorizontalAlignment="Left" Background="#276E9F" Margin="0,12,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="確認・復元">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <TextBlock Text="バックアップを確認して新しい場所へ復元" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="既存のアプリ・設定・音楽フォルダーは上書きしません。従来の管理データ専用バックアップは設定画面の旧メニューから復元できます。"
                       Foreground="#B8C5D3" TextWrapping="Wrap" Margin="0,6,0,13"/>
            <TextBlock Text="完全バックアップ（.vccsbackup）"/>
            <DockPanel Margin="0,4,0,0">
              <Button Content="参照…" DockPanel.Dock="Right" Click="ChooseRestoreArchive_Click"/>
              <TextBox x:Name="RestoreArchiveText"/>
            </DockPanel>
            <Button Content="内容・SHA-256を検証" Click="Inspect_Click" HorizontalAlignment="Left" Margin="0,8,0,8"/>
            <TextBlock x:Name="InspectText" Foreground="#B8C5D3" TextWrapping="Wrap"/>
            <TextBlock Text="復元先（まだ存在しない新しいフォルダー）" Margin="0,18,0,4"/>
            <DockPanel>
              <Button Content="親フォルダーを選択…" DockPanel.Dock="Right" Click="ChooseRestoreParent_Click"/>
              <TextBox x:Name="RestoreTargetText"/>
            </DockPanel>
            <TextBlock Text="Data＝アプリの管理データ、Application＝実行ファイル、Libraries＝選択した音楽フォルダーです。展開後のRESTORE-README.txtを確認し、必要な音楽フォルダーを設定画面で登録してください。現在の設定への自動適用は行いません。"
                       Foreground="#B8C5D3" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <Button x:Name="RestoreButton" Content="新しい場所へ復元" Click="Restore_Click"
                    HorizontalAlignment="Left" Background="#3A7048" Margin="0,12,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <Button x:Name="CloseButton" Content="閉じる" DockPanel.Dock="Right" Click="Close_Click"/>
      <Button x:Name="CancelOperationButton" Content="作業を中断" DockPanel.Dock="Right" Click="CancelOperation_Click" IsEnabled="False"/>
      <StackPanel>
        <ProgressBar x:Name="OperationProgress" Height="8" Minimum="0" Maximum="100" Margin="3,0,20,4"/>
        <TextBlock x:Name="OperationStatus" Text="待機中" Foreground="#B8C5D3" TextTrimming="CharacterEllipsis" MaxWidth="680"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
