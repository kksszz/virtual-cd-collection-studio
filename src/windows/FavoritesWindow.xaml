<Window x:Class="ZipMp3Player.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="お気に入り" Width="900" Height="580" MinWidth="650" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="#15171B" Foreground="#F2F3F5">
  <Window.Resources>
    <Style TargetType="ContextMenu"><Setter Property="Background" Value="#252A32"/><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="MenuItem"><Setter Property="Background" Value="#252A32"/><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2C313A"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#454C58"/><Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="3"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#2C313A"/><Setter Property="Foreground" Value="#F2F3F5"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#2879B8"/><Setter Property="Foreground" Value="White"/>
      </Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10">
      <ComboBox x:Name="FavoriteModeCombo" Width="210" SelectedIndex="0" SelectionChanged="Filter_Changed"
                Background="#F3F4F6" Foreground="#18202A" Margin="0,0,12,0">
        <ComboBoxItem Content="★ お気に入りの曲"/>
        <ComboBoxItem Content="★ お気に入りアルバムの全曲"/>
      </ComboBox>
      <TextBlock Text="検索" Foreground="#B6C7D8" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="SearchTextBox" TextChanged="Search_Changed" Padding="7,5" Background="#20252D"
               Foreground="White" BorderBrush="#454C58" ToolTip="曲名・アーティスト・アルバムを検索"/>
    </DockPanel>
    <TextBlock x:Name="SummaryText" Grid.Row="1" Foreground="#B6C7D8" Margin="0,0,0,8"/>
    <Grid Grid.Row="2">
      <DataGrid x:Name="FavoritesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                Background="#1D2127" Foreground="#F2F3F5" RowBackground="#1D2127" AlternatingRowBackground="#252A32"
                GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#343A44" BorderBrush="#454C58"
                HeadersVisibility="Column" RowHeight="29" MouseDoubleClick="FavoritesGrid_MouseDoubleClick"
                SelectionChanged="Selection_Changed" PreviewKeyDown="FavoritesGrid_KeyDown" PreviewMouseRightButtonDown="FavoritesGrid_RightButtonDown">
        <DataGrid.ContextMenu>
          <ContextMenu Opened="TrackContextMenu_Opened">
            <MenuItem x:Name="TrackPropertiesMenuItem" Header="プロパティ" Click="TrackProperties_Click"/>
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="曲名" Binding="{Binding Title}" Width="2*" MinWidth="180"/>
          <DataGridTextColumn Header="アーティスト" Binding="{Binding Artist}" Width="*" MinWidth="150"/>
          <DataGridTextColumn Header="アルバム" Binding="{Binding AlbumTitle}" Width="1.5*" MinWidth="180"/>
          <DataGridTextColumn Header="時間" Binding="{Binding DurationText}" Width="60"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="EmptyText" Foreground="#B6C7D8" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center" TextWrapping="Wrap" Margin="20" IsHitTestVisible="False"/>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,10,0,0">
      <Button Content="閉じる" IsCancel="True" DockPanel.Dock="Right"/>
      <Button x:Name="PlaySelectedButton" Content="選択した曲から再生" Click="PlaySelected_Click" DockPanel.Dock="Right"/>
      <Button x:Name="PlayAllButton" Content="▶ 一覧を再生" Click="PlayAll_Click" DockPanel.Dock="Right"/>
      <TextBlock Text="表示順に連続再生します" Foreground="#B6C7D8" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
