<Application x:Class="ZipMp3Player.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Windowsテーマに左右されず、暗い背景上では必ず明るい文字を使う。 -->
    <Style TargetType="Label"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
  </Application.Resources>
</Application>
