<Window x:Class="ZipMp3Player.ArtworkLookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アルバム画像を検索" Icon="Assets/AppIcon.ico" Width="760" Height="610" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="#15171B" Foreground="#F2F3F5">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#303744"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#566171"/><Setter Property="Padding" Value="13,7"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#F4F5F7"/><Setter Property="Foreground" Value="#151A20"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="アルバム名" VerticalAlignment="Center"/>
      <TextBox x:Name="AlbumTextBox" Grid.Column="1" Margin="0,0,10,0"/>
      <Button x:Name="SearchButton" Grid.Column="2" Content="検索" Click="Search_Click" MinWidth="82"/>
    </Grid>
    <Grid Grid.Row="1" Margin="0,9,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="アーティスト" VerticalAlignment="Center"/>
      <TextBox x:Name="ArtistTextBox" Grid.Column="1" Margin="0,0,10,0"/>
      <TextBlock x:Name="StatusText" Grid.Column="2" Width="170" Foreground="#AEB8C5" VerticalAlignment="Center" TextAlignment="Right"/>
    </Grid>
    <Border Grid.Row="2" BorderBrush="#3C4552" BorderThickness="1" Background="#1E2127">
      <Grid>
        <ListBox x:Name="CandidateList" Background="Transparent" BorderThickness="0" Foreground="White"
                 MouseDoubleClick="CandidateList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="100" Height="100" Background="#101216" BorderBrush="#48515D" BorderThickness="1">
                  <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Candidate.Summary}" Margin="12,4" VerticalAlignment="Center"
                           FontSize="14" TextWrapping="Wrap"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" Text="検索すると、利用できるアルバム画像の候補を表示します"
                   Foreground="#7F8996" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Text="提供: MusicBrainz / Cover Art Archive" Foreground="#8F99A6" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="キャンセル" Click="Cancel_Click" Margin="8,0"/>
        <Button x:Name="UseButton" Content="この画像を使用" Click="Use_Click" IsEnabled="False" Background="#276E9F"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
