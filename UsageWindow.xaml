<Window x:Class="ZipMp3Player.UsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="再生履歴・Usage" Icon="Assets/AppIcon.ico" Width="1120" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#111419" Foreground="#F2F3F5">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <!-- Item templates must not fall back to the system's black text brush. -->
    <Style TargetType="ItemsControl"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#F2F3F5"/>
      <Setter Property="Background" Value="#232B35"/>
      <Setter Property="BorderBrush" Value="#46515F"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,3,0">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#354353"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#2C4357"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#68B9E8"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="White"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#303744"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#566171"/><Setter Property="Padding" Value="14,7"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#2C313A"/><Setter Property="Foreground" Value="#F2F3F5"/>
      <Setter Property="BorderBrush" Value="#454C58"/><Setter Property="Padding" Value="7,6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2879B8"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#1D252E"/><Setter Property="BorderBrush" Value="#354555"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="4"/>
    </Style>
    <Style x:Key="Section" TargetType="Border">
      <Setter Property="Background" Value="#191E25"/><Setter Property="BorderBrush" Value="#313B47"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="4"/>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#1D2A35" BorderBrush="#36556F" BorderThickness="1" CornerRadius="7" Padding="14,10" Margin="0,0,0,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="再生履歴ダッシュボード" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="これまでの再生記録を集計して表示します" Foreground="#9EABB8" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
        <TextBlock x:Name="SummaryText" Foreground="#B8C2CE" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <TabControl Grid.Row="1" Background="#15191F" BorderBrush="#353E49" Foreground="#F2F3F5">
      <TabItem Header="ダッシュボード">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="7">
            <UniformGrid Columns="3" Margin="0,0,0,8">
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="累計再生時間" Foreground="#91A0AF"/><TextBlock x:Name="TotalTimeText" FontSize="25" FontWeight="SemiBold" Foreground="#73C4F2" Margin="0,4,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="総再生回数" Foreground="#91A0AF"/><TextBlock x:Name="TotalPlaysText" FontSize="25" FontWeight="SemiBold" Foreground="#87D7A0" Margin="0,4,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="記録された曲" Foreground="#91A0AF"/><TextBlock x:Name="TrackCountText" FontSize="25" FontWeight="SemiBold" Foreground="#D4B5F5" Margin="0,4,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="アーティスト" Foreground="#91A0AF"/><TextBlock x:Name="ArtistCountText" FontSize="25" FontWeight="SemiBold" Foreground="#F0C477" Margin="0,4,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="アルバム" Foreground="#91A0AF"/><TextBlock x:Name="AlbumCountText" FontSize="25" FontWeight="SemiBold" Foreground="#E89D9D" Margin="0,4,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="いちばん聴いた曲" Foreground="#91A0AF"/><TextBlock x:Name="FavoriteTrackText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/><TextBlock x:Name="FavoriteTrackDetailText" Foreground="#91A0AF" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></Border>
            </UniformGrid>

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Style="{StaticResource Section}">
                <StackPanel><TextBlock Text="よく聴くアーティスト" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <ItemsControl x:Name="TopArtistList"><ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Height="43" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="#F2F3F5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Grid Height="5" Margin="0,5,8,0" HorizontalAlignment="Left"><Border Width="250" Background="#29323C" CornerRadius="3"/><Border Width="{Binding BarWidth}" Background="#3D9CD3" CornerRadius="3"/></Grid></StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="#A8B4C0" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Section}">
                <StackPanel><TextBlock Text="よく聴くアルバム" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <ItemsControl x:Name="TopAlbumList"><ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Height="43" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="#F2F3F5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Secondary}" Foreground="#8794A1" FontSize="10" TextTrimming="CharacterEllipsis"/><Grid Height="5" Margin="0,3,8,0" HorizontalAlignment="Left"><Border Width="250" Background="#29323C" CornerRadius="3"/><Border Width="{Binding BarWidth}" Background="#BA7DD1" CornerRadius="3"/></Grid></StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="#A8B4C0" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Style="{StaticResource Section}">
                <StackPanel><TextBlock Text="再生時間ランキング" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <ItemsControl x:Name="TopTrackList"><ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Height="40"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Rank}" Foreground="#68B9E8" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="#F2F3F5" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Secondary}" Foreground="#8794A1" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="#A8B4C0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Section}">
                <StackPanel><TextBlock Text="最近聴いた曲" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <ItemsControl x:Name="RecentTrackList"><ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Height="40"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="#F2F3F5" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Secondary}" Foreground="#8794A1" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="#A8B4C0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock Text="日別・月別の推移は、今後の再生から日時別ログを記録すると表示できます。" Foreground="#73808D" FontSize="10" Margin="8,5,0,5"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="すべての履歴">
        <DataGrid x:Name="UsageGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False"
                  MouseDoubleClick="UsageGrid_MouseDoubleClick"
                  Background="#1E2127" Foreground="#F2F3F5" BorderBrush="#353B45"
                  RowBackground="#1E2127" AlternatingRowBackground="#23272E"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#303640">
          <DataGrid.Columns>
            <DataGridTextColumn Header="アーティスト" Binding="{Binding Artist}" Width="2*" MinWidth="150"/>
            <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="3*" MinWidth="190"/>
            <DataGridTextColumn Header="アルバム" Binding="{Binding Album}" Width="2*" MinWidth="150"/>
            <DataGridTextColumn Header="再生回数" Binding="{Binding PlayCount}" Width="82"/>
            <DataGridTextColumn Header="累計再生時間" Binding="{Binding PlayedTime}" SortMemberPath="PlayedSeconds" Width="112"/>
            <DataGridTextColumn Header="曲の長さ" Binding="{Binding Duration}" SortMemberPath="DurationSeconds" Width="88"/>
            <DataGridTextColumn Header="最終再生" Binding="{Binding LastPlayed}" SortMemberPath="LastPlayedValue" Width="135"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="ライブラリ変更">
        <DataGrid x:Name="LibraryChangeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False"
                  Background="#1E2127" Foreground="#F2F3F5" BorderBrush="#353B45"
                  RowBackground="#1E2127" AlternatingRowBackground="#23272E"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#303640">
          <DataGrid.Columns>
            <DataGridTextColumn Header="日時" Binding="{Binding Occurred}" Width="145"/>
            <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="75"/>
            <DataGridTextColumn Header="アルバム" Binding="{Binding AlbumTitle}" Width="2*" MinWidth="180"/>
            <DataGridTextColumn Header="曲数" Binding="{Binding TrackCount}" Width="80"/>
            <DataGridTextColumn Header="場所" Binding="{Binding Path}" Width="3*" MinWidth="260"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>

    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock Text="詳細履歴の曲をダブルクリックすると再生できます。" Foreground="#929CA9" VerticalAlignment="Center"/>
      <Button Content="閉じる" Click="Close_Click" HorizontalAlignment="Right" MinWidth="86"/>
    </DockPanel>
  </Grid>
</Window>
