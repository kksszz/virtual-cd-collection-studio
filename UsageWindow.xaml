<Window x:Class="ZipMp3Player.UsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="再生履歴・Usage" Icon="Assets/AppIcon.ico" Width="980" Height="620" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#15171B" Foreground="#F2F3F5">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#303744"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#566171"/><Setter Property="Padding" Value="14,7"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#2C313A"/><Setter Property="Foreground" Value="#F2F3F5"/>
      <Setter Property="BorderBrush" Value="#454C58"/><Setter Property="Padding" Value="7,6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2879B8"/><Setter Property="Foreground" Value="White"/></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#1E2730" BorderBrush="#35516A" BorderThickness="1" CornerRadius="4" Padding="12,9" Margin="0,0,0,10">
      <DockPanel>
        <TextBlock Text="再生履歴・Usage" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
        <TextBlock x:Name="SummaryText" Foreground="#B8C2CE" HorizontalAlignment="Right" TextAlignment="Right"/>
      </DockPanel>
    </Border>
    <DataGrid x:Name="UsageGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False"
              MouseDoubleClick="UsageGrid_MouseDoubleClick"
              Background="#1E2127" Foreground="#F2F3F5" BorderBrush="#353B45"
              RowBackground="#1E2127" AlternatingRowBackground="#23272E"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#303640">
      <DataGrid.Columns>
        <DataGridTextColumn Header="アーティスト" Binding="{Binding Artist}" Width="2*" MinWidth="150"/>
        <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="3*" MinWidth="190"/>
        <DataGridTextColumn Header="アルバム" Binding="{Binding Album}" Width="2*" MinWidth="150"/>
        <DataGridTextColumn Header="再生回数" Binding="{Binding PlayCount}" Width="82"/>
        <DataGridTextColumn Header="累計再生時間" Binding="{Binding PlayedTime}" SortMemberPath="PlayedSeconds" Width="112"/>
        <DataGridTextColumn Header="曲の長さ" Binding="{Binding Duration}" SortMemberPath="DurationSeconds" Width="88"/>
        <DataGridTextColumn Header="最終再生" Binding="{Binding LastPlayed}" SortMemberPath="LastPlayedValue" Width="135"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock Text="曲をダブルクリックすると再生します。各列の見出しをクリックすると並べ替えられます。"
                 Foreground="#929CA9" VerticalAlignment="Center"/>
      <Button Content="閉じる" Click="Close_Click" HorizontalAlignment="Right" MinWidth="86"/>
    </DockPanel>
  </Grid>
</Window>
