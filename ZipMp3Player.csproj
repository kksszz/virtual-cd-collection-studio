<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Virtual CD Collection Studio</AssemblyName>
    <RootNamespace>ZipMp3Player</RootNamespace>
    <Title>Virtual CD Collection Studio</Title>
    <Product>Virtual CD Collection Studio</Product>
    <Description>Preserve, explore and play complete CD collections in a virtual library</Description>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>0.74.0</Version>
    <InformationalVersion>0.74.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>0.74.0.0</AssemblyVersion>
    <FileVersion>0.74.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.png" />
    <EmbeddedResource Include="Assets\ThirdParty\CdDvdCase\CdCaseBottom.stl" LogicalName="ZipMp3Player.Assets.CdCaseBottom.stl" />
    <EmbeddedResource Include="Assets\ThirdParty\CdDvdCase\CdCaseTop.stl" LogicalName="ZipMp3Player.Assets.CdCaseTop.stl" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="AiDevHarness\**\*.cs" />
    <Compile Remove="BackupDevHarness\**\*.cs" />
    <Compile Remove="AudioDevHarness\**\*.cs" />
    <Compile Remove="ThemeDevHarness\**\*.cs" />
    <Compile Remove="OcrDevHarness\**\*.cs" />
    <Compile Remove="LyricsDevHarness\**\*.cs" />
    <Compile Remove="FormatDevHarness\**\*.cs" />
    <Compile Remove="GaplessDevHarness\**\*.cs" />
    <None Remove="GaplessDevHarness\**\*" />
    <Compile Remove="TagEditDevHarness\**\*.cs" />
    <None Remove="BackupDevHarness\**\*" />
    <None Remove="AudioDevHarness\**\*" />
    <None Remove="ThemeDevHarness\**\*" />
    <None Remove="OcrDevHarness\**\*" />
    <None Remove="LyricsDevHarness\**\*" />
    <None Remove="FormatDevHarness\**\*" />
    <None Remove="TagEditDevHarness\**\*" />
    <Compile Remove="AiGuitarPreviewService.cs" />
    <None Remove="AiGuitarPreviewService.cs" />
    <None Remove="AiDevHarness\**\*" />
    <None Remove=".ai-dev\**\*" />
    <None Remove="ai_guitar_preview.py" />
  </ItemGroup>
</Project>
