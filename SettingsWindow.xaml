<Window x:Class="ZipMp3Player.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Icon="Assets/AppIcon.ico" Width="720" Height="690" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#15171B" Foreground="#F2F3F5">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F2F3F5"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#303744"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#566171"/><Setter Property="Padding" Value="13,7"/>
      <Setter Property="Margin" Value="3"/>
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="2,0,0,12">
      <TextBlock Text="音楽ライブラリ" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="チェックを外したフォルダは登録を残したままアルバム一覧から非表示になります。登録解除しても元のファイルは削除されません。"
                 Foreground="#A9B3C0" Margin="0,5,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#1E2127" BorderBrush="#3E4652" BorderThickness="1" CornerRadius="4">
      <ListBox x:Name="FolderList" Background="Transparent" Foreground="White" BorderThickness="0"
               SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="{Binding Path}" ToolTip="{Binding Path}"
                      Margin="10,8" Checked="FolderEnabled_Changed" Unchecked="FolderEnabled_Changed"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <DockPanel Grid.Row="2" Margin="0,9,0,12">
      <Button Content="＋ フォルダを追加" Click="AddFolder_Click"/>
      <Button Content="－ 選択を登録解除" Click="RemoveFolder_Click"/>
      <Button Content="⇄ 選択フォルダの場所を変更" Click="RelocateFolder_Click"/>
      <TextBlock x:Name="FolderCountText" HorizontalAlignment="Right" Foreground="#A9B3C0" VerticalAlignment="Center"/>
    </DockPanel>
    <Border Grid.Row="3" Background="#1E2730" BorderBrush="#35516A" BorderThickness="1" CornerRadius="4" Padding="12,9" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="データのバックアップと移行" FontWeight="SemiBold" FontSize="15"/>
          <TextBlock Text="設定・ライブラリ情報・お気に入り・再生履歴・取得画像・保存歌詞を対象にします。音楽ファイルは含みません。"
                     Foreground="#A9B3C0" FontSize="11" TextWrapping="Wrap" Margin="0,4,12,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="バックアップ作成" Click="CreateBackup_Click"/>
          <Button Content="バックアップから復元" Click="RestoreBackup_Click"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="4" Background="#1E2730" BorderBrush="#35516A" BorderThickness="1" CornerRadius="4" Padding="12,9" Margin="0,0,0,12">
      <StackPanel>
        <CheckBox x:Name="TagBackupCheck" Content="タグ編集時に元ファイルのバックアップを保存する"
                  FontWeight="SemiBold" Checked="TagBackupOption_Changed" Unchecked="TagBackupOption_Changed"/>
        <TextBlock Text="デフォルトは無効です。有効時はアルバムフォルダではなく、下の専用フォルダへ保存します。"
                   Foreground="#A9B3C0" FontSize="11" Margin="20,4,0,6" TextWrapping="Wrap"/>
        <DockPanel x:Name="TagBackupFolderPanel" Margin="20,0,0,0">
          <Button Content="保存先を選択" DockPanel.Dock="Right" Click="ChooseTagBackupFolder_Click" Padding="10,5"/>
          <TextBox x:Name="TagBackupFolderTextBox" Margin="0,3,5,3" Padding="7,5"
                   Background="#F3F4F6" Foreground="#18202A" BorderBrush="#566171"
                   ToolTip="タグ編集バックアップの保存先フォルダ"/>
        </DockPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="5" Background="#1E2730" BorderBrush="#35516A" BorderThickness="1" CornerRadius="4" Padding="12,9" Margin="0,0,0,12">
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="表示言語" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="LanguageCombo" Width="130" SelectionChanged="Language_Changed"
                      Background="#F3F4F6" Foreground="#18202A">
              <ComboBoxItem Content="日本語" Tag="ja"/>
              <ComboBoxItem Content="英語" Tag="en"/>
            </ComboBox>
          </StackPanel>
          <TextBlock Text="アプリの動作" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
        </DockPanel>
        <CheckBox x:Name="MinimizeOnCloseCheck" Content="右上の×で終了せず、タスクバーへ最小化する"
                  Margin="0,7,0,0" ToolTip="再生を続けたまま最小化します。終了は設定画面の［アプリを終了］を使用します。"/>
        <CheckBox x:Name="AutomaticArtworkCheck" Content="画像のないアルバムのジャケットを自動取得する" Margin="0,7,0,0"
                  ToolTip="作品名・アーティスト名をMusicBrainzとTheAudioDBへ送信します。高解像度を優先し、600px未満は保存しません。音楽・ZIPは変更しません。"/>
        <CheckBox x:Name="AutomaticArtworkPauseCheck" Content="自動取得を一時停止（保存して反映）" Margin="20,5,0,0"/>
      </StackPanel>
    </Border>
    <DockPanel Grid.Row="6">
      <Button x:Name="ExitApplicationButton" Content="アプリを終了" Click="ExitApplication_Click" DockPanel.Dock="Left" Background="#743B3B"/>
      <Button Content="キャンセル" Click="Cancel_Click" DockPanel.Dock="Right"/>
      <Button Content="保存して閉じる" Click="Save_Click" DockPanel.Dock="Right" Background="#276E9F"/>
      <Button Content="保存して再スキャン" Click="SaveAndRescan_Click" DockPanel.Dock="Right" Background="#3A7048"/>
    </DockPanel>
  </Grid>
</Window>
